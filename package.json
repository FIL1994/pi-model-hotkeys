{
  "name": "@philvr/pi-model-hotkeys",
  "version": "0.1.0",
  "description": "Nine configurable model hotkeys for Pi.",
  "keywords": [
    "hotkeys",
    "keyboard-shortcuts",
    "models",
    "pi-extension",
    "pi-package",
    "terminal"
  ],
  "homepage": "https://github.com/FIL1994/pi-model-hotkeys#readme",
  "bugs": {
    "url": "https://github.com/FIL1994/pi-model-hotkeys/issues"
  },
  "license": "MIT",
  "author": "Phil Van Raalte",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FIL1994/pi-model-hotkeys.git"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/model-hotkeys.ts"
    ]
  }
}
